---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../config';
---
<BaseLayout title="项目" description="我正在进行的项目、长期计划与实验。">
  <section class="page-shell inner-heading"><p class="section-kicker">THINGS IN PROGRESS / 小小实践</p><h1>正在进行<span class="heading-dot">.</span></h1><p>先把想法做出来，再慢慢打磨。这里记录那些愿意长期投入的事。</p></section>
  <section class="page-shell projects-page"><div class="project-grid">{projects.map(project => <a href={project.link} class:list={['project-card', `tone-${project.accent}`]}><div class="project-top"><span>{project.number} / {project.category}</span><span aria-hidden="true">↗</span></div><div class="project-decoration" aria-hidden="true"><span></span><span></span></div><div class="project-content"><h3>{project.name}</h3><p>{project.description}</p><span class="project-more">{project.linkLabel} →</span></div></a>)}</div><p class="projects-note">这两个项目是示例内容。你可以在 <code>src/config.ts</code> 中换成自己的作品。</p></section>
</BaseLayout>
