---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { siteConfig, projects } from '../config';
import { getPublishedPosts } from '../lib/posts';
const posts = await getPublishedPosts();
---
<BaseLayout>
  <section class="home-hero page-shell">
    <div class="hero-copy">
      <div class="eyebrow"><span class="status-dot"></span> AN INDEPENDENT SPACE FOR THOUGHTS <span class="eyebrow-no">/ 2026</span></div>
      <h1>给思想一个<br /><em>安静生长</em>的地方<span class="full-stop">。</span></h1>
      <p class="hero-description">{siteConfig.intro}</p>
      <div class="hero-actions">
        <a class="button-primary" href="/writing/">阅读我的文字 <span aria-hidden="true">↗</span></a>
        <a class="text-link" href="/about/">认识一下 <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <div class="hero-art" aria-hidden="true">
      <div class="art-frame">
        <div class="art-orbit art-orbit-one"></div>
        <div class="art-orbit art-orbit-two"></div>
        <div class="art-sun"></div>
        <div class="art-land art-land-back"></div>
        <div class="art-land art-land-front"></div>
        <div class="art-caption"><span>FIG. 01</span><span>SPACE TO GROW</span></div>
      </div>
      <div class="art-note"><span class="art-note-symbol">✳</span> Less noise,<br />more meaning.</div>
    </div>
    <div class="hero-bottom"><span>01 / 探索与记录</span><span>SCROLL TO DISCOVER <span aria-hidden="true">↓</span></span></div>
  </section>

  <section class="editorial-section page-shell" id="latest">
    <div class="section-heading">
      <div><p class="section-kicker">JOURNAL / 文字</p><h2>最近写作<span class="heading-dot">.</span></h2></div>
      <a href="/writing/" class="section-link">查看全部文章 <span aria-hidden="true">↗</span></a>
    </div>
    <div class="article-list">
      {posts.length ? posts.slice(0, 4).map((post, index) => <ArticleCard post={post} index={index} />) : <p class="muted">第一篇文章即将出现。</p>}
    </div>
  </section>

  <section class="quote-band">
    <div class="page-shell quote-inner">
      <span class="quote-symbol" aria-hidden="true">“</span>
      <p>写下来，是为了让那些稍纵即逝的念头，<br /><em>有机会成为更长久的东西。</em></p>
      <span class="quote-aside">A NOTE TO MYSELF & OTHERS</span>
    </div>
  </section>

  <section class="editorial-section page-shell project-section">
    <div class="section-heading">
      <div><p class="section-kicker">CURRENTLY MAKING / 正在做</p><h2>一些正在生长的事<span class="heading-dot">.</span></h2></div>
      <a href="/projects/" class="section-link">更多项目 <span aria-hidden="true">↗</span></a>
    </div>
    <div class="project-grid">
      {projects.map(project => (
        <a href={project.link} class:list={['project-card', `tone-${project.accent}`]}>
          <div class="project-top"><span>{project.number} / {project.category}</span><span aria-hidden="true">↗</span></div>
          <div class="project-decoration" aria-hidden="true"><span></span><span></span></div>
          <div class="project-content"><h3>{project.name}</h3><p>{project.description}</p><span class="project-more">{project.linkLabel} →</span></div>
        </a>
      ))}
    </div>
  </section>

  <section class="bottom-cta page-shell">
    <p class="section-kicker">THANKS FOR VISITING</p>
    <h2>如果你也相信，<br />好的思考值得慢慢发生。</h2>
    <a href="/about/" class="button-outline">关于我和这个地方 <span aria-hidden="true">↗</span></a>
  </section>
</BaseLayout>
