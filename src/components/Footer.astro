---
import { siteConfig } from '../config';
---
<footer class="site-footer">
  <div class="page-shell footer-top">
    <div>
      <p class="footer-brand">{siteConfig.name}<span class="footer-dot">.</span></p>
      <p class="muted">好好生活，认真记录。</p>
    </div>
    <div class="footer-links">
      <a href="/writing/">所有文章</a>
      <a href="/about/">关于这里</a>
      <a href="/rss.xml" target="_blank" rel="noopener noreferrer">RSS 订阅 ↗</a>
      {siteConfig.github && <a href={siteConfig.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>}
    </div>
  </div>
  <div class="page-shell footer-bottom">
    <span>© {siteConfig.startYear}–{new Date().getFullYear()} {siteConfig.author}. Built with care.</span>
    <span>独立思考 · 自由表达 · 持续生长</span>
  </div>
</footer>
